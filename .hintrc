{
  "connector": {
    "name": "local",
    "options": {
      "pattern": [
        "**",
        "!.git/**",
        "!node_modules/**"
      ]
    }
  },
  "extends": [
    "development"
  ],
  "formatters": [
    "stylish"
  ],
  "hints": {
    "button-type": "default",
    "disown-opener": "default",
    "html-checker": [
      "default",
      {
        "validator": "https://validator.w3.org/nu/?out=json"
      }
    ],
    "meta-charset-utf-8": "default",
    "meta-viewport": "default"
  },
  "browserslist": [
    "defaults",
    "not ie 11",
    "not ios_saf <= 26",
    "not safari <= 26.1"
  ]
}